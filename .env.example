# EdgeQuake Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# LLM Provider Configuration (CRITICAL - READ THIS)
# =============================================================================
# EdgeQuake uses explicit environment variables to determine which LLM provider to use.
# 
# RECOMMENDATION: Always explicitly set EDGEQUAKE_DEFAULT_LLM_PROVIDER to avoid
# configuration confusion. The provider selection should be predictable and clear.

# -----------------------------------------------------------------------------
# Workspace Default Models (REQUIRED FOR PREDICTABLE CONFIGURATION)
# -----------------------------------------------------------------------------
# These environment variables define the default provider for all workspaces.
# ALWAYS SET THESE to avoid auto-detection behavior:

EDGEQUAKE_DEFAULT_LLM_PROVIDER=gemini
EDGEQUAKE_DEFAULT_LLM_MODEL=gemini-2.5-flash
EDGEQUAKE_DEFAULT_EMBEDDING_PROVIDER=gemini
EDGEQUAKE_DEFAULT_EMBEDDING_MODEL=gemini-embedding-001
EDGEQUAKE_DEFAULT_EMBEDDING_DIMENSION=3072

# Alternative: Use Ollama for local development
# EDGEQUAKE_DEFAULT_LLM_PROVIDER=ollama
# EDGEQUAKE_DEFAULT_LLM_MODEL=gemma3:12b
# EDGEQUAKE_DEFAULT_EMBEDDING_PROVIDER=ollama
# EDGEQUAKE_DEFAULT_EMBEDDING_MODEL=embeddinggemma
# EDGEQUAKE_DEFAULT_EMBEDDING_DIMENSION=768

# -----------------------------------------------------------------------------
# Option 1: Project API Keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Multiple Google API keys for rotation (comma-separated)
# When quota is exceeded, system will rotate through these keys
# GOOGLE_API_KEYS=key1,key2,key3
GOOGLE_API_KEYS=

# Note: EdgeQuake container reads GEMINI_API_KEY — mapped from GOOGLE_API_KEY in docker-compose.yml
S2_API_KEY=your_semantic_scholar_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
# -----------------------------------------------------------------------------
# Option 2: Ollama (Local/remote, self-hosted) - RECOMMENDED FOR DEVELOPMENT
# -----------------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=gemma3:12b                    # Chat model (128K context, vision)
# OLLAMA_EMBEDDING_MODEL=embeddinggemma      # Embedding model (768 dimensions)

# Default Ollama Models (set in models.toml):
#   - Chat/LLM: gemma3:12b (128K context, vision support)
#   - Embedding: embeddinggemma (768 dimensions)

# -----------------------------------------------------------------------------
# Option 3: LM Studio (Local, OpenAI-compatible API)
# -----------------------------------------------------------------------------
# LMSTUDIO_HOST=http://localhost:1234
# LMSTUDIO_MODEL=gemma2-9b-it                # Chat model
# LMSTUDIO_EMBEDDING_MODEL=nomic-embed-text  # Embedding model
# LMSTUDIO_EMBEDDING_DIM=768                 # Embedding dimension

# =============================================================================
# Database Configuration
# ============================================================================= PostgreSQL Database URL (optional - enables persistent storage)
# If not set, the application will use in-memory storage (data lost on restart)
# Format: postgresql://username:password@host:port/database
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edgequake

# =============================================================================
# Server Configuration
# =============================================================================
HOST=0.0.0.0
PORT=8080

# =============================================================================
# PDF Extraction Configuration (OODA-E2E-01)
# =============================================================================
# Path to libpdfium shared library for PDF text extraction.
# Required for PDF upload processing. Without this, PDF extraction
# falls back to MockBackend (returns empty content).
#
# Download from: https://github.com/bblanchon/pdfium-binaries/releases
# Bundled with project at: edgequake/crates/edgequake-pdf/lib/lib/libpdfium.dylib
#
# The server will auto-discover the bundled library, but you can override:
# PDFIUM_DYNAMIC_LIB_PATH=/path/to/libpdfium.dylib

# =============================================================================
# Worker Configuration
# =============================================================================
# Number of background workers for document processing
WORKER_THREADS=4

# =============================================================================
# Logging Configuration
# =============================================================================
# Logging Level
# Options: trace, debug, info, warn, error
RUST_LOG=edgequake=debug,tower_http=debug,axum=debug
