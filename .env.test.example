## Strict full-pipeline test environment
## Copy to .env.test and export before running test:pipeline:* scripts.

# Real backend and frontend endpoints
TEST_BACKEND_BASE_URL=http://127.0.0.1:8000
TEST_FRONTEND_BASE_URL=http://127.0.0.1:8080

# Runtime evidence logs
TEST_BACKEND_LOG_PATH=/tmp/uvicorn.log
TEST_EDGEQUAKE_LOG_CMD=docker compose logs --tail=400 edgequake

# Strict policy toggles
TEST_STRICT_NO_MOCKS=1
TEST_STRICT_NO_FALLBACKS=1

# Provider policy (must match backend runtime)
PLAN_PROVIDER=auto
PLAN_ENABLE_GOOGLE_FALLBACK=false

# Repeatability suite
TEST_REPEAT_RUNS=3
TEST_ARTIFACT_PATH=tests/artifacts/repeatability_results.json
